NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Chave pública do painel do Supabase (sb_publishable_...). Projetos antigos podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Defina como false depois de criar sua conta para esconder o cadastro na tela de login.
# O bloqueio real é feito no Supabase (veja "Publicar para uso pessoal" no README).
NEXT_PUBLIC_ALLOW_SIGNUP=true
